# Copy this file to .env and fill it in. .env is ignored by git: never commit real secrets.

# Where MongoDB is. Not needed with docker compose, which sets it for you.
SPRING_MONGODB_URI=mongodb://localhost:27017/journaldb

# Signs login tokens. At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Encrypts journal titles and content in the database. Exactly 32 random bytes, base64-encoded.
# Generate one with:  openssl rand -base64 32
# Keep a backup: if this key is lost or changed, existing entries can no longer be read.
JOURNAL_ENCRYPTION_KEY=

# Optional: creates this admin user at startup if it does not exist yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=
